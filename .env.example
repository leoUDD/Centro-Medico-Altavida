# Cada llave es de 32 bytes en base64. Generar con:
#   python -c "import base64,secrets;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# Deben ser distintas entre sí y guardarse fuera del repositorio y de la base de datos.
CLAVE_CIFRADO=
CLAVE_IDENTIDAD=
CLAVE_INDICES=
CLAVE_AUDITORIA=
# Solo durante una rotación de llaves (ver manage.py rotar_llaves):
# CLAVE_CIFRADO_ANTERIOR=
# CLAVE_IDENTIDAD_ANTERIOR=
DJANGO_SECRET_KEY=

# Entorno (ver config/settings.py). Por defecto el sistema arranca en modo seguro: DEBUG apagado.
# En desarrollo local definir DJANGO_DEBUG=1 (sirve los estilos y muestra errores detallados).
# DJANGO_DEBUG=1
# Hosts permitidos, separados por comas (obligatorio con DEBUG apagado).
# DJANGO_ALLOWED_HOSTS=
# Con 1 (producción detrás de TLS) las cookies son seguras y se fuerza HTTPS con HSTS.
# DJANGO_HTTPS=0

